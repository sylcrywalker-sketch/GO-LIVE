    _russian: "<line-height=110><size=16><indent=30><color=#A4B5C2>\u041F\u043E\u0438\u0441\u043A \u0442\u043E\u0432\u0430\u0440\u043E\u0432...</color></indent></size>\n<line-height=38><size=22><b>\u0411\u044E\u0434\u0436\u0435\u0442\u043D\u0430\u044F \u0432\u0438\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u0430</b></size>\n<line-height=184><size=26>$15.00</size>\n<line-height=34><size=22>\u041A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430</size>\n<size=16><color=#8F9FAB>\u041F\u043E\u043A\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E</color></size>"
