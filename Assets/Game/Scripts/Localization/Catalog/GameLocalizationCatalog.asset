    _russian: "\u041A\u0443\u043F\u0438\u0442\u044C"
    _english: Buy
  - _key: phone.unavailable
    _russian: "\u041D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E"
